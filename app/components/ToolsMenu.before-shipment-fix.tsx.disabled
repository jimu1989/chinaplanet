"use client";

import { useEffect, useMemo, useState } from "react";

type Language = "ar" | "en" | "zh";

type Tab =
  | "time"
  | "weather"
  | "currency"
  | "shipping"
  | "holidays";

type City = {
  name: string;
  country: string;
  countryCode: "SA" | "CN";
  latitude: number;
  longitude: number;
};

type Weather = {
  temperature: number;
  apparent: number;
  wind: number;
  humidity: number;
};

type Holiday = {
  name: string;
  chineseName: string;
  start: string;
  end: string;
  days: number;
  workdays?: string[];
  note: string;
};

