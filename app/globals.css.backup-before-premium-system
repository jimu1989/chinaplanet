@import "tailwindcss";

:root {
  --background: #f7f3ec;
  --foreground: #302923;

  --cp-brown: #40372f;
  --cp-brown-deep: #29221d;
  --cp-muted: #786e65;

  --cp-red: #b94b3f;
  --cp-red-soft: #c96858;
  --cp-gold: #b5966c;
  --cp-gold-light: #d7bc91;

  --cp-line: #e4dbd1;
  --cp-white: #fffdf9;

  --cp-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --mouse-x: 50vw;
  --mouse-y: 50vh;
  --mouse-x-percent: 50%;
  --mouse-y-percent: 50%;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(
      circle at 78% 8%,
      rgba(185, 75, 63, 0.055),
      transparent 25rem
    ),
    radial-gradient(
      circle at 12% 42%,
      rgba(181, 150, 108, 0.045),
      transparent 24rem
    ),
    var(--background);
  color: var(--foreground);
  font-family: var(--font-arabic), sans-serif;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.035;
  background-image:
    linear-gradient(rgba(64, 55, 47, 0.25) 1px, transparent 1px),
    linear-gradient(90deg, rgba(64, 55, 47, 0.25) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: linear-gradient(to bottom, black, transparent 70%);
}

::selection {
  background: rgba(185, 75, 63, 0.18);
  color: var(--cp-brown-deep);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
}

img {
  max-width: 100%;
}

.cp-container {
  width: min(1180px, calc(100% - 40px));
  margin-inline: auto;
}

.cp-section {
  position: relative;
  padding-block: 110px;
}

.cp-label {
  color: var(--cp-red);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.28em;
  line-height: 1;
  text-transform: uppercase;
}

.cp-title {
  color: var(--cp-brown);
  font-weight: 500;
  letter-spacing: -0.035em;
}

.cp-line {
  width: 34px;
  height: 1px;
  flex: 0 0 auto;
  background: var(--cp-red);
}

.cp-button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding-inline: 26px;
  border: 1px solid rgba(185, 75, 63, 0.48);
  border-radius: 999px;
  background: transparent;
  color: var(--cp-brown);
  font-size: 13px;
  font-weight: 600;
  transition:
    background 450ms var(--cp-ease),
    color 450ms var(--cp-ease),
    border-color 450ms var(--cp-ease),
    transform 450ms var(--cp-ease),
    box-shadow 450ms var(--cp-ease);
}

.cp-button:hover {
  transform: translateY(-2px);
  border-color: var(--cp-red);
  background: var(--cp-red);
  color: white;
  box-shadow: 0 14px 35px rgba(100, 45, 38, 0.14);
}

.cp-link-line {
  position: relative;
}

.cp-link-line::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: -6px;
  left: 0;
  height: 1px;
  transform: scaleX(0);
  transform-origin: right;
  background: currentColor;
  transition: transform 450ms var(--cp-ease);
}

.cp-link-line:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.cp-atmosphere {
  position: absolute;
  pointer-events: none;
  border-radius: 999px;
  filter: blur(70px);
  opacity: 0.5;
}

.cp-atmosphere-red {
  background: rgba(185, 75, 63, 0.16);
}

.cp-atmosphere-gold {
  background: rgba(181, 150, 108, 0.13);
}

.cp-editorial-grid {
  position: relative;
}

.cp-editorial-grid::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    var(--cp-line) 15%,
    var(--cp-line) 85%,
    transparent
  );
}

.cp-interactive {
  transform: translateZ(0);
  backface-visibility: hidden;
}

.cp-motion-card {
  transition:
    transform 800ms var(--cp-ease),
    box-shadow 800ms var(--cp-ease),
    border-color 500ms var(--cp-ease);
}

.cp-motion-card:hover {
  box-shadow: 0 28px 80px rgba(40, 30, 20, 0.1);
}

.cp-motion-image {
  transform: scale(1.01);
  transition: transform 1000ms var(--cp-ease);
}

.group:hover .cp-motion-image {
  transform: scale(1.045);
}

.cp-cursor-glow {
  position: relative;
  isolation: isolate;
}

.cp-cursor-glow::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  border-radius: inherit;
  opacity: 0;
  background: radial-gradient(
    260px circle at var(--mouse-x-percent) var(--mouse-y-percent),
    rgba(185, 75, 63, 0.075),
    transparent 70%
  );
  transition: opacity 500ms ease;
}

.cp-cursor-glow:hover::after {
  opacity: 1;
}

.cp-magnetic {
  transition: transform 500ms var(--cp-ease);
}

@media (pointer: fine) and (prefers-reduced-motion: no-preference) {
  .cp-motion-card {
    transform: perspective(1200px)
      rotateX(calc((var(--mouse-y) - 50vh) * -0.004deg))
      rotateY(calc((var(--mouse-x) - 50vw) * 0.004deg))
      translate3d(
        calc((var(--mouse-x) - 50vw) * 0.0025),
        calc((var(--mouse-y) - 50vh) * 0.0025),
        0
      );
  }

  .cp-motion-image {
    transform: scale(1.01)
      translate3d(
        calc((var(--mouse-x) - 50vw) * -0.004),
        calc((var(--mouse-y) - 50vh) * -0.004),
        0
      );
  }

  .group:hover .cp-motion-image {
    transform: scale(1.045)
      translate3d(
        calc((var(--mouse-x) - 50vw) * -0.006),
        calc((var(--mouse-y) - 50vh) * -0.006),
        0
      );
  }

  .cp-magnetic:hover {
    transform: translate3d(
      calc((var(--mouse-x) - 50vw) * 0.004),
      calc((var(--mouse-y) - 50vh) * 0.004),
      0
    );
  }
}

@keyframes cp-fade-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cp-float {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -10px, 0);
  }
}

@keyframes chinaPlanetSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes chinaPlanetOrbit {
  from {
    transform: translate(-50%, -50%) rotate(0deg) translateX(71px) rotate(0deg);
  }

  to {
    transform: translate(-50%, -50%) rotate(360deg) translateX(71px)
      rotate(-360deg);
  }
}

@keyframes destinationFade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes destinationRise {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: cp-fade-in 650ms ease-out both;
}

@media (max-width: 768px) {
  .cp-container {
    width: min(100% - 28px, 1180px);
  }

  .cp-section {
    padding-block: 76px;
  }

  .cp-editorial-grid::before {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }

  .cp-motion-card,
  .cp-motion-image,
  .cp-magnetic {
    transform: none !important;
  }

  .cp-cursor-glow::after {
    display: none;
  }
}
